@startuml classes
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam nodesep 25
skinparam ranksep 45
hide empty members
top to bottom direction

package agent {
  class HumanController
  class BotController
  class RemoteController {
    Finish(result SessionResult)
  }
  class eventPump {
    Flush()
    Wait()
  }
}
package ui {
  class TextUI {
    OnEvent(e Event)
    AskForCard(cards, question) int
    AskForActivity(draft, options, counts) int
    ShowFinalResults(result)
  }
}
package net {
  interface Transport {
    Send(m Message) error
    Receive() (Message, error)
    SetReadDeadline(t) error
    Close() error
  }
  class TCPTransport
  class Message {
    Type : MessageType
    Data : json.RawMessage
  }
}
package engine {
  class Game {
    Play() SessionResult
    -passHands(round, catch)
    -updateEndOfRound()
  }
  interface PlayerController {
    ChooseThrow(hand) *Card
    ChooseDraft(hand) *Card
    ChooseActivity(hand, alreadyScored) *Symbol
  }
}
package scoring {
  class SessionResult {
    Scores : []*ScoreSheet
    Winner : int
  }
  class "ScoreRound()\nScoreFinal()" as ScoringFuncs <<functions>>
}
package edition {
  interface Edition {
    Cards() []*Card
    Rules() map[Category]ScoringRule
    GetWinner(sheets) int
  }
  class "GetEdition(id)" as Registry <<function>>
  class "australia / europe / usa" as Editions
  class "shared.ScoringFunc" as ScoringFunc <<adapter>>
}
package core {
  interface ScoringRule {
    Score(p int, all []*PlayerState) int
  }
  interface PassingStrategy {
    Target(round, seat, n) int
    CatchTarget(round, seat, n) int
  }
  class "Passing\n(left, right, alternate)" as Passing
  interface EventServer {
    Publish(ev Event)
    Subscribe() <-chan Event
    CancelSubscription(ch)
  }
  interface Event
  class "RoundBegins, RevealCard,\nRevealDraft, RoundScore" as Events
  class PlayerState {
    Hand, Draft : []*Card
    VisitedSites : []byte
    ChosenActivity : *Symbol
    ScoredActivities : []*Symbol
    MoveCardToDraft(card)
  }
  class ScoreSheet {
    CategoryScores : map[Category][]int
    Add(round, category, points)
    CategoryTotal(category) int
    Total() int
  }
  class Deck {
    Shuffle(rng)
    Deal(n) []*Card
  }
  class Card {
    Name, Region : string
    Site : byte
    Value : int
    Symbols : map[Category]*Symbol
  }
  class Symbol {
    Name : string
    Value : int
  }
}

HumanController ..|> PlayerController
BotController ..|> PlayerController
RemoteController ..|> PlayerController
RemoteController --> Transport
RemoteController --> BotController : fallback
RemoteController *-- eventPump
HumanController *-- eventPump
HumanController --> TextUI
TCPTransport ..|> Transport
Transport ..> Message
eventPump ..> EventServer : subscribes

Game --> "2..4" PlayerController
Game --> EventServer : publishes
Game --> Edition
Game --> PassingStrategy
Game *-- "2..4" PlayerState
Game --> Deck
Game ..> ScoringFuncs
ScoringFuncs ..> SessionResult

Registry ..> Edition : returns
Editions ..|> Edition
Editions ..> ScoringFunc : builds rules
ScoringFunc ..|> ScoringRule
Edition ..> ScoringRule

Passing ..|> PassingStrategy
Events ..|> Event
EventServer ..> Event
PlayerState *-- ScoreSheet
PlayerState o-- Card
Deck o-- Card
Card o-- "2" Symbol

' Layout hints: stack the packages and keep each one narrow.
TextUI -[hidden]down- Transport
Message -[hidden]down- Game
SessionResult -[hidden]down- Registry
Passing -[hidden]down- EventServer
@enduml
